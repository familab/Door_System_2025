{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:3667",
  "Door": {
    "Hardware": {
      "//": "GPIO pin numbers use the BCM numbering scheme (same as the Python project).",
      "UseRealHardware": false,
      "RelayPin": 17,
      "ButtonUnlockPin": 27,
      "ButtonLockPin": 22,
      "I2cBusId": 1,
      "Pn532I2cAddress": 36
    },
    "Timing": {
      "UnlockDurationSeconds": 3600,
      "BadgeUnlockDurationSeconds": 5,
      "DebounceSeconds": 0.5,
      "NfcPollIntervalMilliseconds": 100
    },
    "Storage": {
      "//": "Provider is either 'Sqlite' or 'Json'.",
      "Provider": "Sqlite",
      "SqlitePath": "data/door.db",
      "BadgeJsonPath": "data/badges.json"
    },
    "Health": {
      "RefreshIntervalSeconds": 300
    },
    "Auth": {
      "//": "MasterPasswordHash format: pbkdf2_sha256$<iterations>$<saltBase64>$<hashBase64>. Default below verifies the password 'changeme'.",
      "MasterUsername": "admin",
      "MasterPasswordHash": "pbkdf2_sha256$100000$ABEiM0RVZneImqu8zd7v8A==$sb87PE5SVx+GvGG9tirFWcus4aBq3U/HPcKV5H66298=",
      "SessionTtlHours": 8,
      "FailThrottleSeconds": 15,
      "WhitelistEmails": [],
      "WhitelistDomains": [],
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  }
}
